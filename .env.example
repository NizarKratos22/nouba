# Copy to .env.local and fill in. Never commit .env.local.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string

# MongoDB (local service, docker compose, or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/nouba_dev

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Optional, only when the app is reachable from the internet (Render): webhook id from the dashboard
PAYPAL_WEBHOOK_ID=

# Anthropic (the treasurer's brain)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Treasurer safety
# Money actions above this amount (in the circle currency) always need organizer approval
TREASURER_APPROVAL_CAP=1000
# Secret for the hourly treasurer tick endpoint (Render cron or any scheduler)
CRON_SECRET=change-me-too
